# S-UI-only setup for PGClockBot. Copy the needed values into .env.
# This file intentionally contains no real credentials.

BOT_TOKEN=""
BOT_USERNAME=""
ADMIN_IDS=""

PANEL_BACKEND="sui"
SUI_BASE_URL="http://127.0.0.1:2095/app"
SUI_API_TOKEN="PUT_S_UI_API_V2_TOKEN_HERE"
# Use the server IP when there is no domain or certificate.
SUI_SUBSCRIPTION_BASE_URL="http://SERVER_IP:2096/sub"
# Put the inbound IDs that customers should receive, for example: 1,2
SUI_INBOUND_IDS=""
SUI_ADMIN_USERNAME="s-ui"

WEB_HOST="0.0.0.0"
WEB_PORT="9000"
WEB_SECRET=""
WEB_ADMIN_USER="admin"
WEB_ADMIN_PASSWORD=""

# Empty WEBHOOK_URL keeps Telegram in polling mode; no domain or TLS is needed.
WEBHOOK_URL=""
WEBHOOK_PATH="/telegram/webhook"
PUBLIC_BASE_URL=""

CURRENCY="Toman"
DEFAULT_LOCALE="fa"
DATABASE_URL="postgresql+asyncpg://pgclock:CHANGE_ME@127.0.0.1:5432/pgclock"
